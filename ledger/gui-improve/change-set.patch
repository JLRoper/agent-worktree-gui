  *              tree is returned, so the caller can create/claim its row and file the card there.
  *   refuse   — the asked path is the parent of a run sitting in a worktree git does not list (or `ok:false` from
  *              `resolveJobTree`): there is no real row to claim, so the press must say the row is missing rather
- *              than quietly file the card on the checkout.
+ *              than quietly file the card on the checkout. The run's OWN tree is refused the same way when the
+ *              board has no project that contains it, but the sentence names the tree and what would give it a row.
  */
 export function attachMeaning({ job = {}, asked = "", resolved = null } = {}) {
   const run = jobTreePath(job);
   const root = worktreeRootIn(run);
   if (!root) return { action: "allow", path: norm(asked), why: "" };
   if (!isInsidePath(asked, root)) return { action: "allow", path: norm(asked), why: "" };
+  // The press names the run's OWN tree, not the checkout that contains it. When there is no row for it, the old
+  // sentence described the tree as "only the checkout that contains it", which is the opposite of what it is. Say
+  // what is missing and the one action that gives the tree a row: a scan root above the checkout, or git listing
+  // the tree under the project the board already knows.
+  if (key(asked) === key(root) && !resolved?.ok) {
+    const checkout = root.replace(/\/\.worktrees\/[^/]+$/i, "");
+    const parent = checkout.replace(/\/[^/]+$/, "");
+    return {
+      action: "refuse",
+      path: null,
+      why: resolved?.project
+        ? `the row for ${root} is missing - git worktree list for ${resolved.project.name} does not name that tree (${resolved.why || "no match"}), so the board has no row to file this card under`
+        : `the row for ${root} is missing - the board reads only the repositories directly inside a scan root, and ${checkout} is not one of them, so it has never read that tree. Add ${parent || checkout} under Settings > Board > Folders the board scans, then reload`,
+    };
+  }
   if (resolved?.ok) {
     const path = norm(resolved.path);
     return { action: key(path) === key(asked) ? "allow" : "redirect", path, why: "" };
