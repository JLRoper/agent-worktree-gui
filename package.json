{
  "name": "agent-worktree-gui",
  "version": "0.93.0",
  "private": true,
  "type": "module",
  "description": "Local GUI panel that monitors git worktrees across one or more projects (branches, merge status vs remote main, PR state, dirty work, live activity).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "hooks:install": "git config core.hooksPath .githooks",
    "branches": "node tools/merged-branches.mjs",
    "changelog": "node tools/changelog.mjs",
    "changelog:check": "node tools/changelog.mjs --check",
    "render:pipelines": "node tools/render-pipelines.mjs",
    "verify:pipelines-viz": "node tools/verify-pipelines-viz.mjs",
    "verify:version-tags": "node tools/verify-version-tags.mjs",
    "audit:child-process": "node tools/child-process-audit.mjs",
    "verify": "node tools/verify.mjs --list",
    "verify:all": "node tools/verify.mjs --all",
    "verify:console-render": "node tools/verify-console-render.mjs",
    "verify:flicker": "node tools/verify-console-flicker.mjs",
    "verify:stream-default": "node tools/verify-stream-default.mjs",
    "verify:two-assistants": "node tools/verify-two-assistants-e2e.mjs",
    "verify:wake-ladder": "node tools/verify-wake-ladder.mjs",
    "verify:settings-window": "node tools/verify-settings-window.mjs",
    "verify:chart-top-count": "node tools/verify-chart-top-count.mjs",
    "verify:settings-tabs": "node tools/verify-settings-tabs.mjs",
    "verify:pipelines-tab": "node tools/verify-pipelines-tab.mjs",
    "verify:settings-skills": "node tools/verify-settings-skills.mjs",
    "verify:new-project": "node tools/verify-new-project.mjs",
    "verify:banner-timeout": "node tools/verify-banner-timeout.mjs",
    "verify:assistant-2-chat": "node tools/verify-assistant-2-chat.mjs",
    "verify:preamble-cost": "node tools/verify-preamble-cost.mjs",
    "verify:digest-cost": "node tools/verify-digest-cost.mjs",
    "verify:queue-holds": "node tools/verify-queue-holds.mjs",
    "verify:spawn-links-queue": "node tools/verify-spawn-links-queue.mjs",
    "verify:queue-drag": "node tools/verify-queue-drag.mjs",
    "verify:approvals-dock": "node tools/verify-approvals-dock.mjs",
    "dogfood:chat": "node tools/dogfood-chat.mjs",
    "verify:attachment-spawn": "node tools/verify-attachment-spawn.mjs",
    "verify:turn-pager": "node tools/verify-turn-pager.mjs",
    "verify:human-button": "node tools/verify-human-button.mjs",
    "verify:provider-profiles": "node tools/verify-provider-profiles.mjs",
    "verify:assistant-dock-overlap": "node tools/verify-assistant-dock-overlap.mjs",
    "measure:perf-paths": "node tools/measure-perf-paths.mjs",
    "verify:task-pipeline-window": "node tools/verify-task-pipeline-window.mjs",
    "verify:action-harvest": "node tools/verify-action-harvest.mjs",
    "verify:restart-line-harvest": "node tools/verify-restart-line-harvest.mjs",
    "seed:pipeline-bundle": "node tools/seed-pipeline-bundle.mjs",
    "test": "node --test --test-concurrency=4 test/*.test.js",
    "test:e2e:task-window": "node --test --test-reporter=spec test/e2e/task-window.spec.mjs",
    "test:e2e:minimized-composer": "node --test --test-reporter=spec test/e2e/minimized-composer.spec.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {}
}
