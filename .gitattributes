# The commit-msg hook is a POSIX shell script: a CRLF shebang is not executable, and
# core.autocrlf=true would hand every checkout CRLF line endings. Scoped to .githooks/ so no
# existing file's checkout changes.
.githooks/** text eol=lf

# The role seed is a byte-for-byte copy of a charter a reader wrote, and its sha256 is quoted in the commit
# that added it: a CRLF checkout would change those bytes and quietly make that claim false. `-text` keeps
# both the blob and every checkout as the reader's own file, and it is scoped to this folder so no existing
# file's checkout changes.
data/roles/** -text

# The vendored mermaid bundle and the renders that inline it are byte-for-byte artefacts: a render quotes the
# bundle's sha256 and node tools/verify-pipelines-viz.mjs asserts the bundle sits inside the page. A CRLF
# checkout would change both files' bytes and quietly make both claims false. `-text` keeps the blob and every
# checkout as they were written, scoped to these folders so no existing file's checkout changes.
tools/vendor/** -text
docs/pipelines/viz/** -text

# The gui-improve change-set is a diff a reader applies to the tree, and a CRLF checkout breaks it:
# `git apply` then matches nothing, because every context line ends in a CR the file does not have.
# `-text` keeps the patch's own bytes so `git apply -p1` works from any checkout of this branch.
ledger/**/*.patch -text
