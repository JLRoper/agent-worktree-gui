#!/bin/sh
# .githooks/pre-push — a push cannot carry a bump-worthy branch with no version bump, and a push of the base
# branch cannot carry a stale CHANGELOG.md.
#
# WHY: the version lives once, in package.json, and it is the only thing that tells the board's own config
# line (and a reader) which build is running. Which level it moves by is a judgement the LANDING AGENT makes
# from the diff and lands in the same PR as the change — see docs/versioning.md — but "remember to bump" is
# not a pipeline. This hook runs the gate that PR is meant to pass, node tools/version.mjs check, on the
# branch being pushed, so forgetting it is a refused push rather than a version nobody wanted to move.
#
# The second gate is the landing's last step: a push that lands the BASE branch while CHANGELOG.md is stale is a
# landing nobody rendered. The hook runs node tools/land.mjs --check on that push and refuses, naming the one
# command that does the whole step (render, commit only CHANGELOG.md, push, prove). Only a base push is gated —
# a worktree branch's changelog is the base's business, and its own bump is the check above.
#
# It is fast and offline: check reads refs and package.json, never the network. It compares the branch's
# committed number with the number at origin/main's current tip, and prints what it compared on both outcomes;
# the hook discards that line on success, so an allowed push stays quiet, and forwards it on refusal, where it
# names the commits it counted and the level it would have suggested. A branch that is merely behind main is a
# refusal too: it still carries the number it was cut at, and "different" is not "bumped".
# Deliberate bypass: git push --no-verify
#
# INSTALL (repo config, so one install covers every worktree of this clone): npm run hooks:install
# The check reads the branch checked out in this working tree — the panel pushes one branch per worktree.

set -u

# A clone that has not got the tool, or has no node, must push as it always did: a hook that cannot run its
# own check is not a reason to block somebody's landing.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
TOOL="$ROOT/tools/version.mjs"
[ -f "$TOOL" ] || exit 0
command -v node >/dev/null 2>&1 || exit 0

# git hands this hook one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# Only a push that actually adds commits is worth checking — a deletion and an up-to-date ref are not.
new_commits=0
base_push=0
if [ -t 0 ]; then
    new_commits=1                                            # run by hand with nothing on stdin: check anyway
    case "$(git symbolic-ref --short -q HEAD 2>/dev/null || true)" in main|master) base_push=1 ;; esac
else
    while read -r lref lsha rref rsha; do
        [ -n "${lref:-}" ] || continue
        case "$lref" in refs/tags/*) continue ;; esac                                   # a tag moves no branch
        [ "${lsha:-}" = "0000000000000000000000000000000000000000" ] && continue        # deleting the ref
        case "$lref" in refs/heads/main|refs/heads/master) base_push=1 ;; esac          # the base push is gated below
        case "${rsha:-}" in
            ""|0000000000000000000000000000000000000000) new_commits=$((new_commits + 1)) ;;   # a new ref
            *) n=$(git rev-list --count "$rsha..$lsha" 2>/dev/null) || n=1
               [ "${n:-0}" -gt 0 ] && new_commits=$((new_commits + 1)) ;;
        esac
    done
fi
[ "$new_commits" -gt 0 ] || exit 0

out=$(node "$TOOL" check 2>&1)
status=$?
if [ "$status" -ne 0 ]; then
    branch=$(git symbolic-ref --short -q HEAD || echo "this branch")
    {
        printf '%s\n' "pre-push: refused — $branch would go out with no version bump"
        printf '%s\n' "$out"
        printf '%s\n' \
            "Nothing was pushed. The bump belongs in the same PR as the change — docs/versioning.md has the scale." \
            "  node tools/version.mjs apply <patch|minor|major>    (writes the number, commits it, tags the commit)" \
            "  git push --no-verify                                (deliberate bypass of this hook)" \
            ""
    } >&2
    exit 1
fi

# A BASE PUSH THAT LEAVES CHANGELOG.md STALE IS A LANDING NOBODY RENDERED. The render is the base's LAST step
# (docs/versioning.md) and node tools/land.mjs does the whole step: render from the base's own history, commit
# only CHANGELOG.md, push, prove. Only a base push is gated — a worktree branch's changelog is the base's
# business, and its own bump is the check above. A tool that cannot run its check never blocks a push: only the
# "stale" answer (exit 1) does. This is the gate that makes "remember to render" a pipeline step instead of a hope.
if [ "${base_push:-0}" -eq 1 ] && [ -f "$ROOT/tools/land.mjs" ] && [ -f "$ROOT/CHANGELOG.md" ]; then
    land_out=$(node "$ROOT/tools/land.mjs" --check --no-fetch 2>&1)
    land_status=$?
    if [ "$land_status" -eq 1 ]; then
        {
            printf '%s\n' "pre-push: refused — this push would land a base whose CHANGELOG.md is stale"
            printf '%s\n' "$land_out"
            printf '%s\n' \
                "Nothing was pushed. The render is the base's last step, and one command does the whole step:" \
                "  npm run land                                        (render, commit only CHANGELOG.md, push, prove)" \
                "  npm run land:check                                  (the gate on its own: writes nothing)" \
                "  git push --no-verify                                (deliberate bypass of this hook)" \
                ""
        } >&2
        exit 1
    fi
fi

exit 0
