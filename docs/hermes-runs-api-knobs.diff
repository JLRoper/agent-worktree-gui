+def _resolve_run_knobs(body: Any, _openai_error) -> Tuple[Optional[str], Optional[int], Optional[float], Any]:
+    """Per-run ``cwd`` / ``max_turns`` / ``run_budget`` from a run body (local patch).
+
+    ``cwd`` must be an existing directory: a run told to work in a tree that is not there would
+    otherwise write somewhere else entirely, which is worse than refusing it. The two caps are
+    plain numbers; an unparseable value is a 400 rather than a silent default.
+    """
+    if not isinstance(body, dict):
+        return None, None, None, None
+    cwd: Optional[str] = None
+    raw_cwd = body.get("cwd")
+    if raw_cwd not in (None, ""):
+        if not isinstance(raw_cwd, str):
+            return None, None, None, _json_error(_openai_error, "cwd must be a string path", status=400, code="invalid_cwd")
+        candidate = os.path.abspath(os.path.expanduser(raw_cwd))
+        if not os.path.isdir(candidate):
+            return None, None, None, _json_error(
+                _openai_error, f"cwd is not an existing directory: {raw_cwd}", status=400, code="invalid_cwd")
+        cwd = candidate
+    max_turns: Optional[int] = None
+    raw_turns = body.get("max_turns")
+    if raw_turns not in (None, ""):
+        try:
+            max_turns = max(1, int(raw_turns))
+        except (TypeError, ValueError):
+            return None, None, None, _json_error(_openai_error, "max_turns must be an integer", status=400, code="invalid_max_turns")
+    run_budget: Optional[float] = None
+    raw_budget = body.get("run_budget")
+    if raw_budget not in (None, ""):
+        try:
+            run_budget = float(raw_budget)
+        except (TypeError, ValueError):
+            return None, None, None, _json_error(_openai_error, "run_budget must be a number of seconds", status=400, code="invalid_run_budget")
+        if run_budget <= 0:
+            return None, None, None, _json_error(_openai_error, "run_budget must be positive", status=400, code="invalid_run_budget")
+    return cwd, max_turns, run_budget, None
+
