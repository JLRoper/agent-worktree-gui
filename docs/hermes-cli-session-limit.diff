+def _configured_session_list_limit() -> int:
+    """How many sessions the in-chat browser shows: ``sessions.list_limit`` from config.yaml.
+
+    Local patch. The number was a literal ``10`` at every call site, so a reader with a long history
+    could only ever see the last ten and had no way to ask for more. Clamped to 1..500 — this is a
+    menu, not a dump (``hermes sessions list --limit`` and ``sessions browse`` are for that).
+    """
+    try:
+        from hermes_cli.config import load_config_readonly
+
+        raw = (load_config_readonly().get("sessions") or {}).get("list_limit", 10)
+        value = int(raw)
+    except Exception:
+        return 10
+    return max(1, min(value, 500))
+
