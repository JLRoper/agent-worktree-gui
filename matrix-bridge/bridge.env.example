# bridge.env.example — the configuration template for hermes_matrix_bridge.py.
#
# Copy this file to bridge.env, in the SAME DIRECTORY as hermes_matrix_bridge.py:
#
#     cd matrix-bridge
#     cp bridge.env.example bridge.env
#
# bridge.env holds the Matrix account password in plain text. It is ignored by git
# (.gitignore), it must never be committed, and it must never be copied anywhere.
#
# Format: one KEY=VALUE per line. A comment must be on its own line — text after a
# value on the same line becomes part of the value. Quotes around a value are
# stripped; there is no shell expansion. A key already present in the process
# environment wins over the file, so `MATRIX_ROOM_ID=... python ...` overrides it.

# ── Matrix account ───────────────────────────────────────────────────────────

# Base URL of the homeserver, without /_matrix. Where you log in with Element.
MATRIX_HOMESERVER=https://matrix.org

# The bot's full Matrix user id, @localpart:server. Create a dedicated account for
# the bridge; do not use a personal account. Password login must be enabled for it
# (an SSO-only account cannot be used here).
MATRIX_USERNAME=@REPLACE_WITH_BOT_USER:matrix.org

# SECRET. The bot account's password. You set it when the account is created, or
# change it in Element → Settings → Account. Every access token is derived from it
# at start; there is no token variable in this file.
MATRIX_PASSWORD=CHANGE_ME

# The one room the bridge serves. It looks like !opaque:server — not a #alias and
# not a room name. Invite the bot first, then run `--rooms` to read it (README §4).
MATRIX_ROOM_ID=!CHANGE_ME:matrix.org

# Stable device name. Keep it constant: the E2EE keys in MATRIX_STORE_DIR are tied
# to this device id, and changing it makes the bot a new, untrusted device.
MATRIX_DEVICE_ID=HERMESBRIDGE

# Where matrix-nio keeps the E2EE key store, the sync database and bridge.pid.
# Use one directory per account/device; deleting it loses the device's keys and
# makes old encrypted history undecryptable. A relative path resolves against the
# working directory — this directory when the panel starts the bridge. The code's
# default, used when this line is absent, is ~/.hermes-matrix-store.
MATRIX_STORE_DIR=store

# ── Local Hermes CLI (the inference backend) ─────────────────────────────────

# Full path to hermes.exe (not the .cmd shim). Leave empty to auto-detect from
# PATH and the standard Hermes install locations.
HERMES_BIN=

# Comma-separated Hermes toolsets the bot may use, e.g. web,terminal. Empty means
# Hermes' default toolset. See the security note in README §12 before enabling
# terminal for a room other people can post in.
HERMES_TOOLSETS=

# Seconds one Hermes inference may run before it is cut off.
HERMES_TIMEOUT=300

# ── The panel (policy and reminders) ─────────────────────────────────────────

# Base URL of the agent-worktree-gui panel this bridge belongs to. The panel hands this to the child it
# starts (derived from the port it actually bound), so a panel-started bridge needs nothing here. Set it
# for a foreground run on another port, or to point the bridge at a panel on another host.
# The bridge reads GET /api/matrix/policy and GET /api/matrix/reminders on EVERY turn. Nothing is cached
# across turns: an edit in the Bridge tab reaches the very next message, with no restart.
WTGUI_PANEL_URL=http://127.0.0.1:7331

# Only for a panel on ANOTHER host: that panel's x-panel-token. A loopback request is the panel's own
# exemption, so this stays empty on a normal install. It is a credential: never commit a filled copy.
WTGUI_PANEL_TOKEN=

# Seconds one panel GET may take before the turn runs without it (and says so in its reply).
WTGUI_PANEL_TIMEOUT=5

# ── Conversation and delivery tuning ─────────────────────────────────────────

# Seconds between Matrix typing notices. Must stay below 30 (Matrix expires them).
TYPING_REFRESH=20

# How many previous turns are replayed to Hermes as conversation context.
BRIDGE_HISTORY_TURNS=12

# File used for one-line status messages posted while a long turn is still running.
# The bridge polls it, sends its contents, then renames it to outbox.sent.
# Relative to the working directory; by default it is outbox.txt beside the script.
BRIDGE_OUTBOX=outbox.txt

# Seconds between polls of BRIDGE_OUTBOX.
OUTBOX_DRAIN=5

# ── Read by the code but normally set by the OS ──────────────────────────────
# LOCALAPPDATA is used only to auto-detect hermes.exe on Windows. Do not set it
# here; Windows already provides it. HOME / USERPROFILE likewise feed the default
# MATRIX_STORE_DIR through Path.home().
